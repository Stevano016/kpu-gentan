# Live-update socket for the Gentan production deployment.
#
# Point this only at the socket server belonging to the same deployment. Leave
# it empty for environments that have no socket server of their own — the
# dashboard then falls back to polling. Pointing it at another environment
# would make that environment's activity drive this one's dashboard.
VITE_LIVE_SOCKET_URL=wss://ws.gentan.wujud.id:10650/ws
